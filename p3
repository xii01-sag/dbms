CREATE DATABASE COMPANY03;
USE COMPANY03;

CREATE TABLE Employee (
    E_id INT PRIMARY KEY,
    E_name VARCHAR(255),
    Age INT,
    Salary DECIMAL(10, 2)
);

DESC Employee;

